---
import Layout from "../../../../layouts/MainLayout.astro";
import CurriculumViewer from "../../../../components/CurriculumViewer.vue";
import QuizInterface from "../../../../components/QuizInterface.vue";
import FirebaseService from "../../../../lib/firebaseService";
import { useAuth } from "../../../../stores/auth";

export async function getStaticPaths() {
  // Get all public classes to generate paths
  const publicClasses = await FirebaseService.getPublicClasses();

  // Generate paths for each quiz in each class
  const paths = [];
  for (const classData of publicClasses) {
    for (const quiz of classData.quizzes) {
      paths.push({
        params: {
          id: classData.id,
          quizId: quiz.id,
        },
        props: {
          classData,
          quiz,
        },
      });
    }
  }
  return paths;
}

const { id, quizId } = Astro.params;
const { classData, quiz } = Astro.props;

// Initialize auth state
const { initialize } = useAuth();
await initialize();
---

<Layout title={`${quiz.title} - ${classData.name}`}>
  <main class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="mb-6">
        <a
          :href="`${import.meta.env.BASE_URL}/curricula`"
          class="text-blue-600 hover:text-blue-800"
        >
          ← Back to curricula
        </a>
      </div>
      <!-- Lesson Plan Content -->
      {
        quiz.lessonPlan && (
          <div class="mt-8">
            <CurriculumViewer client:load markdownContent={quiz.lessonPlan} />
          </div>
        )
      }

      <!-- Quiz Interface -->
      <div class="mt-8 border-t pt-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Take the Quiz</h2>
        <QuizInterface client:load quiz-id={quiz.id} class-id={id} />
      </div>
    </div>
  </main>
</Layout>
