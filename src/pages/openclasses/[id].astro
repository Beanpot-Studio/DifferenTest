---
// open classes - all can view, few can take quiz

import Layout from "../../layouts/MainLayout.astro";
import FirebaseService from "../../lib/firebaseService";
import IconService from "../../components/services/IconService.vue";

export async function getStaticPaths() {
  // Get all public classes to generate paths
  const publicClasses = await FirebaseService.getPublicClasses();

  // Return paths for each class
  return publicClasses.map((classData) => ({
    params: { id: classData.id },
    props: { classData },
  }));
}

const { id } = Astro.params;
const { classData } = Astro.props;

if (!classData) {
  return Astro.redirect("/404");
}

// Get the appropriate image based on class name
const classImage = classData.name.toLowerCase().includes("acatemy")
  ? "/acatemy-banner.png"
  : "/webdev-banner.png";
---

<Layout title={classData.name}>
  <main class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <!-- Hero Section with Image -->
      <div class="relative">
        <img
          src={classImage}
          alt={classData.description}
          class="w-full h-64 object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
        >
        </div>
        <div class="absolute bottom-0 left-0 p-6">
          <h1 class="text-4xl font-bold text-white mb-2">{classData.name}</h1>
          <p class="text-white/90 text-lg max-w-2xl">{classData.description}</p>
        </div>
      </div>

      <!-- Content Section -->
      <div class="p-6">
        <div class="flex items-center text-sm text-gray-500 mb-8">
          <IconService
            name="user"
            size="5"
            color="text-gray-400"
            class="mr-2"
          />
          <span>Created by {classData.teacherName}</span>
        </div>

        <!-- Quiz Navigation -->
        <div class="mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">
            Available Lessons
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              classData.quizzes.map((quiz) => (
                <a
                  href={`/openclasses/${id}/quiz/${quiz.id}`}
                  class="block p-4 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors border border-gray-200"
                  onclick={`if (event.target.closest('a').getAttribute('data-has-skin') === 'true') { 
                    event.preventDefault(); 
                    window.open('/courses/${id}/quiz/${quiz.id}', 'quiz_${id}_${quiz.id}', 'width=900,height=700,resizable=yes,scrollbars=yes,status=yes'); 
                  }`}
                  data-has-skin={
                    classData.name.toLowerCase().includes("acatemy")
                      ? "true"
                      : "false"
                  }
                >
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <img
                        src={quiz.badgeImage || "/badge.png"}
                        alt={`${quiz.title} badge`}
                        class="w-12 h-12 object-contain"
                      />
                      <div>
                        <h3 class="text-lg font-medium text-gray-900">
                          {quiz.title}
                        </h3>
                        {quiz.description && (
                          <p class="text-sm text-gray-500 mt-1">
                            {quiz.description}
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
