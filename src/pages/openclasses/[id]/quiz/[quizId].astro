---
import Layout from "../../../../layouts/MainLayout.astro";
import CurriculumViewer from "../../../../components/CurriculumViewer.vue";
import QuizInterface from "../../../../components/QuizInterface.vue";
import FirebaseService from "../../../../lib/firebaseService";
import { useAuth } from "../../../../stores/auth";
import CatSteppedLesson from "../../../../components/ui/skins/CatSteppedLesson.vue";

// Define Interfaces for stricter typing
interface QuizData {
  id: string;
  title: string;
  lessonPlan?: string; // Markdown content for full lessons
  lessonType?: "full" | "steps"; // Type of lesson
  lessonSteps?: string[]; // Array of markdown strings for stepped lessons
  // Add other quiz properties as needed
}

interface ClassInfo {
  id: string;
  name: string;
  skinId?: string;
  // Add other class properties as needed
}

interface PageProps {
  classData: ClassInfo;
  quiz: QuizData;
}

export async function getStaticPaths() {
  // Type the paths array
  const paths: Array<{
    params: { id: string; quizId: string };
    props: PageProps;
  }> = [];

  // Assuming FirebaseService.getPublicClasses returns an array of ClassInfo
  // and each classData.quizzes is an array of QuizData
  const publicClasses: ClassInfo[] = await FirebaseService.getPublicClasses();

  if (!Array.isArray(publicClasses)) {
    console.error("getPublicClasses did not return an array");
    return []; // Return empty if data is invalid
  }

  for (const classData of publicClasses) {
    // Ensure quizzes exist and is an array before iterating
    const quizRefs = await FirebaseService.getQuizzesByClass(classData.id);
    if (!Array.isArray(quizRefs)) continue;

    for (const quizRef of quizRefs) {
      if (!quizRef || !quizRef.id) continue; // Skip invalid quiz reference

      try {
        // Fetch quiz data
        const potentialQuiz = await FirebaseService.getQuiz(quizRef.id);

        // Ensure the full quiz data was found and has necessary fields, especially title
        if (
          !potentialQuiz ||
          !potentialQuiz.id ||
          typeof potentialQuiz["title"] !== "string"
        ) {
          console.warn(
            `Quiz details are incomplete (missing id or title) for quiz ID: ${quizRef.id} in class ${classData.id}`
          );
          continue;
        }

        // Now that we've validated, we can confidently type it
        const quiz = potentialQuiz as QuizData;

        paths.push({
          params: {
            id: classData.id,
            quizId: quiz.id,
          },
          props: {
            classData,
            quiz,
          },
        });
      } catch (fetchError) {
        console.error(
          `Error fetching full details for quiz ID: ${quizRef.id}`,
          fetchError
        );
        // Decide if you want to skip this path or handle error differently
        continue;
      }
    }
  }
  return paths;
}

// Use the defined interface for Astro.props
const { classData, quiz } = Astro.props as PageProps;
const { id, quizId } = Astro.params; // Params are strings by default

// Get the skinId from the typed class data
const initialSkinId = classData?.skinId || "default";

// Define type for formatted steps
interface FormattedStep {
  title: string;
  content: string;
}

// Prepare lesson steps for CatSteppedLesson component if applicable
let formattedLessonSteps: FormattedStep[] = [];
if (
  quiz.lessonType === "steps" &&
  quiz.lessonSteps &&
  Array.isArray(quiz.lessonSteps)
) {
  formattedLessonSteps = quiz.lessonSteps.map((stepContent, index) => ({
    title: `Step ${index + 1}`,
    content: stepContent,
  }));
}

// A flag to pass to client-side script to know if CatSteppedLesson is being used
const isSteppedLesson =
  quiz.lessonType === "steps" && formattedLessonSteps.length > 0;
---

<Layout title={`${quiz.title} - ${classData.name}`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-4">{classData.name}</h1>
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="mb-6">
        <a href="/curricula" class="text-blue-600 hover:text-blue-800">
          ← Back to curricula
        </a>
      </div>

      <!-- Lesson Plan Content -->
      <div id="lessonArea" class="lesson-content-area mb-8">
        {
          isSteppedLesson ? (
            <CatSteppedLesson
              client:load
              lessonSteps={formattedLessonSteps}
              lessonTitle={quiz.title}
              classQuizzes={[]}
              currentClassId={classData.id}
              currentQuizId={quiz.id}
              on:lesson-completed_document={() => {
                // This custom event name will be dispatched on document
                // We need to ensure CatSteppedLesson dispatches this event on document or a common parent
                // For simplicity here, we'll assume it can be listened to.
                // A more robust way is for CatSteppedLesson to emit, and Astro to forward it to a global function.
                // However, direct DOM manipulation based on component events is tricky in Astro.
                // Let's simplify: CatSteppedLesson's button will trigger the global revealQuizAndHideLesson function.
                // This will require modifying CatSteppedLesson to call a global function.
                // For now, we will handle it via its own event in the script.
              }}
            />
          ) : quiz.lessonPlan ? (
            <div class="curriculum-viewer-container">
              <CurriculumViewer client:load markdownContent={quiz.lessonPlan} />
              {/* Button specific for full lessons (CurriculumViewer) */}
              <div class="text-center mt-6 mb-8">
                <button
                  id="showQuizButtonForFullLesson"
                  class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 text-lg font-semibold"
                >
                  Take the Quiz!
                </button>
              </div>
            </div>
          ) : (
            <div class="text-sm text-gray-500 italic">
              <p>No lesson content available for this quiz.</p>
            </div>
          )
        }
      </div>

      <!-- Quiz Interface (initially hidden) -->
      <div
        id="quizInterfaceContainer"
        style="display: none;"
        class="mt-8 border-t pt-8"
      >
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Take the Quiz</h2>
        <QuizInterface client:load quiz-id={quiz.id} class-id={id} />
      </div>
    </div>
  </main>

  <script define:vars={{ skinToApply: initialSkinId, isSteppedLesson }}>
    if (skinToApply && typeof document !== "undefined") {
      const validSkins = ["default", "cats"]; // Maintain a list of valid skins
      const finalSkin = validSkins.includes(skinToApply)
        ? skinToApply
        : "default";
      document.documentElement.setAttribute("data-theme", finalSkin);
      if (finalSkin !== skinToApply) {
        console.warn(
          `Invalid skin ID "${skinToApply}" received. Applied default.`
        );
      }
    } else if (typeof document !== "undefined") {
      // Apply default if nothing was passed
      document.documentElement.setAttribute("data-theme", "default");
    }
  </script>

  <script define:vars={{ isSteppedLesson }}>
    // Client-side script to toggle quiz visibility
    function revealQuizAndHideLesson() {
      const quizInterfaceContainer = document.getElementById(
        "quizInterfaceContainer"
      );
      const lessonArea = document.getElementById("lessonArea");

      if (quizInterfaceContainer)
        quizInterfaceContainer.style.display = "block";
      if (lessonArea) lessonArea.style.display = "none";

      // If there was a specific button for full lessons, it would be inside lessonArea, so it gets hidden too.
    }

    // Make this function globally accessible IF CatSteppedLesson needs to call it.
    // A better way for component interaction is custom events, but that needs CatSteppedLesson to emit an event that this script can catch.
    window.triggerQuizDisplayFromLesson = revealQuizAndHideLesson;

    document.addEventListener("DOMContentLoaded", () => {
      if (!isSteppedLesson) {
        const showQuizButtonForFullLesson = document.getElementById(
          "showQuizButtonForFullLesson"
        );
        if (showQuizButtonForFullLesson) {
          showQuizButtonForFullLesson.addEventListener(
            "click",
            revealQuizAndHideLesson
          );
        }
      }
      // For CatSteppedLesson, we rely on its internal button calling window.triggerQuizDisplayFromLesson
      // OR if CatSteppedLesson can dispatch a DOM event that bubbles up to `document`:
      // document.addEventListener('lesson-completed-event-from-cat', revealQuizAndHideLesson);
    });
  </script>
</Layout>
