---
export const prerender = false;
import SteppedLessonQuiz from "../../../../components/SteppedLessonQuiz.vue";
import FirebaseService from "../../../../lib/firebaseService";
import "../../../../styles/global.css";

// Define Interfaces for stricter typing
interface QuizData {
  id: string;
  title: string;
  lessonPlan?: string;
  lessonType?: "full" | "steps";
  lessonSteps?: string[];
  classId: string;
  [key: string]: any;
}

const { id, quizId } = Astro.params;

if (!id || !quizId) {
  return Astro.redirect("/404");
}

// Fetch quiz data
const quiz = (await FirebaseService.getQuiz(quizId)) as QuizData | null;

if (!quiz) {
  return Astro.redirect("/404");
}

// Ensure the quiz belongs to the correct class
if (quiz.classId !== id) {
  return Astro.redirect("/404");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{quiz.title} - Lesson</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      body {
        margin: 0;
      }
      main.lesson-container {
        padding: 1rem;
        max-width: 800px;
        margin: auto;
      }
    </style>
  </head>
  <body>
    <main class="lesson-container">
      <SteppedLessonQuiz client:load quiz={quiz} classId={id} />
    </main>
  </body>
</html>
