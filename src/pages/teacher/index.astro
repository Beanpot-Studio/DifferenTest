---
import MainLayout from "../../layouts/MainLayout.astro";
import RoleBasedContent from "../../components/RoleBasedContent.vue";
import TeacherDashboard from "../../components/TeacherDashboard.vue";
---

<MainLayout title="Teacher Portal">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-3xl font-bold mb-6">Teacher Portal</h1>

    <RoleBasedContent client:only :required-roles="['teacher']">
      <TeacherDashboard client:load />
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  // Client-side script for teacher portal
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc } from "firebase/firestore";
  import { auth, db } from "../../lib/firebase";

  // This script will redirect non-teacher users away from this page
  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      // If not logged in, redirect to home page
      window.location.href = "/?auth=required";
      return;
    }

    try {
      const userDoc = await getDoc(doc(db, "users", user.uid));
      if (userDoc.exists()) {
        const role = userDoc.data().role;
        if (role !== "teacher") {
          window.location.href = "/teacher?access=denied";
        }
      }
    } catch (error) {
      console.error("Error checking user role:", error);
    }
  });
</script>
