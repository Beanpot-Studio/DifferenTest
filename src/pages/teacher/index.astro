---
import MainLayout from "../../layouts/MainLayout.astro";
import RoleBasedContent from "../../components/RoleBasedContent.vue";
import QuizGenerator from "../../components/QuizGenerator.vue";
import QuizManager from "../../components/QuizManager.vue";
import ClassManager from "../../components/ClassManager.vue";
---

<MainLayout title="Teacher Portal">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-3xl font-bold mb-6">Teacher Portal</h1>

    <RoleBasedContent client:only requiredRoles={["teacher"]}>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Column: Classes -->
        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold mb-4">Class Management</h2>
            <ClassManager client:load />
          </div>
        </div>

        <!-- Right Column: Quizzes -->
        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold mb-4">Quiz Generator</h2>
            <QuizGenerator client:load />
          </div>

          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold mb-4">Quiz Manager</h2>
            <QuizManager client:load />
          </div>
        </div>
      </div>
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  // Client-side script for teacher portal
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc } from "firebase/firestore";
  import { auth, db } from "../../lib/firebase";

  // This script will redirect non-teacher users away from this page
  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      // If not logged in, redirect to home page
      window.location.href = "/?auth=required";
      return;
    }

    try {
      const userDoc = await getDoc(doc(db, "users", user.uid));
      if (userDoc.exists()) {
        const role = userDoc.data().role;
        if (role !== "teacher") {
          // If not a teacher, redirect to dashboard
          window.location.href = "/dashboard?access=denied";
        }
      }
    } catch (error) {
      console.error("Error checking user role:", error);
    }
  });
</script>
