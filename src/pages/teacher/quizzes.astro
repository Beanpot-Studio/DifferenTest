---
import MainLayout from "../../layouts/MainLayout.astro";
import RoleBasedContent from "../../components/RoleBasedContent.vue";
import QuizGenerator from "../../components/QuizGenerator.vue";
import QuizManager from "../../components/QuizManager.vue";
---

<MainLayout title="Quiz Management">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold">Quiz Management</h1>
      <a href="/teacher" class="text-primary-600 hover:text-primary-800"
        >← Back to Portal</a
      >
    </div>

    <RoleBasedContent client:only :required-roles="['teacher']">
      <div class="space-y-6">
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-2xl font-bold mb-4">Quiz Generator</h2>
          <QuizGenerator client:load />
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-2xl font-bold mb-4">Quiz Manager</h2>
          <QuizManager client:load :classId="selectedClassId" />
        </div>
      </div>
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  import { ref } from "vue";
  const selectedClassId = ref("");
</script>
