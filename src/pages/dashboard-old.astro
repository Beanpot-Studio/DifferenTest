---
import MainLayout from "../layouts/MainLayout.astro";
import RoleBasedContent from "../components/RoleBasedContent.vue";
import PortalLinks from "../components/PortalLinks.vue";
import TeacherDashboard from "../components/TeacherDashboard.vue";
---

<MainLayout title="Dashboard">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">Dashboard</h1>
    <TeacherDashboard client:only />
    <RoleBasedContent client:only>
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold mb-4">Welcome to Your Dashboard</h2>
        <p class="text-secondary-600 mb-6">
          This is your personal dashboard where you can access your content and
          manage your account.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Dashboard Cards -->
          <div
            class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition"
          >
            <h3 class="text-lg font-semibold mb-2">Your Profile</h3>
            <p class="text-secondary-600 mb-3">
              View and edit your personal information
            </p>
            <a
              href="/profile"
              class="text-primary-600 hover:text-primary-800 font-medium"
            >
              View Profile →
            </a>
          </div>
          <div
            class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition"
          >
            <h3 class="text-lg font-semibold mb-2">Messages</h3>
            <p class="text-secondary-600 mb-3">
              Check your messages and notifications
            </p>
            <a
              href="/messages"
              class="text-primary-600 hover:text-primary-800 font-medium"
            >
              View Messages →
            </a>
          </div>

         
          <div
            class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition"
          >
            <h3 class="text-lg font-semibold mb-2">Portal</h3>

            <PortalLinks client:load />
          </div>
        </div>
      </div>
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  import { useAuth } from "../stores/auth";

  // Use the auth store's computed properties for role-based visibility
  const { isTeacher, isStudent } = useAuth();
</script>
