---
export const prerender = false;
import Layout from "../../layouts/MainLayout.astro";
import FirebaseService from "../../lib/firebaseService";

/*export async function getStaticPaths() {
  try {
    // Get all badges from Firebase
    const badges = await FirebaseService.getAllBadges();

    // Return paths for each badge
    return badges.map((badge) => ({
      params: { id: badge.id },
      props: { badge },
    }));
  } catch (error) {
    console.error("Error generating badge paths:", error);
    // Return empty array if there's an error
    return [];
  }
}*/

// Get the badge data for the current page
const { id } = Astro.params;
const badge = await FirebaseService.getBadge(id);

if (!badge) {
  return Astro.redirect("/404");
}

// Format the timestamp
const formatDate = (timestamp) => {
  if (!timestamp) return "Not available";
  const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
};

const pageTitle = `I've earned a badge: ${badge.metadata.badgeName}`;
const pageDescription =
  badge.metadata.badgeDescription ||
  `Achievement badge earned by ${badge.metadata.recipientName || "a student using the DifferenTest platform. Try it at DifferenTest.club"}`;
const pageImage = badge.metadata.badgeImage;
const pageUrl = Astro.url.href; // Get the current page URL

// LinkedIn sharing function (will be used in client-side script)
const linkedInShareBaseUrl = "https://www.linkedin.com/sharing/share-offsite/";
---

<Layout
  title={pageTitle}
  metaTags={[
    { property: "og:title", content: pageTitle },
    { property: "og:description", content: pageDescription },
    { property: "og:image", content: pageImage },
    { property: "og:url", content: pageUrl },
    { property: "og:type", content: "website" },
    { property: "og:image:width", content: "500" },
    { property: "og:image:height", content: "500" },
    // Add Twitter card tags for better sharing on Twitter
    { name: "twitter:card", content: "summary_large_image" },
    { name: "twitter:title", content: pageTitle },
    { name: "twitter:description", content: pageDescription },
    { name: "twitter:image", content: pageImage },
  ]}
>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="p-6">
      <div class="flex items-center space-x-4">
        <div class="flex-shrink-0">
          <img
            src={badge.metadata.badgeImage}
            alt={badge.metadata.badgeName}
            class="w-24 h-24"
          />
        </div>
        <div class="flex-1">
          <h1 class="text-2xl font-bold text-gray-900">
            {badge.metadata.badgeName}
          </h1>
          <p class="mt-1 text-gray-600">{badge.metadata.badgeDescription}</p>
          <div class="mt-4 flex space-x-4 items-center">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800"
            >
              Verified Badge
            </span>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-medium text-gray-900">Badge Details</h2>
        <dl class="mt-4 grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-gray-500">Issued To</dt>
            <dd class="mt-1 text-sm text-gray-900">
              {
                badge.metadata.recipientName ||
                  badge.recipient?.name ||
                  badge.userEmail
              }
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Issued By</dt>
            <dd class="mt-1 text-sm text-gray-900">
              {badge.issuer?.name || "DifferenTest"}
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Issued On</dt>
            <dd class="mt-1 text-sm text-gray-900">
              {formatDate(badge.metadata.completionDate)}
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Badge ID</dt>
            <dd class="mt-1 text-sm text-gray-900 overflow-wrap-anywhere">
              {badge.id}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- Social Share Buttons Row -->
  <div class="mt-6 flex flex-wrap justify-center gap-2">
    <!-- LinkedIn -->
    <button
      id="linkedin-share-button"
      class="px-3 py-1.5 bg-[#0077b5] text-white text-sm rounded-lg hover:bg-[#005e90] flex items-center space-x-1.5 transition-colors"
      title="Share on LinkedIn"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        ><path
          d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"
        ></path></svg
      >
      <span>Share on LinkedIn</span>
    </button>
    <!-- Twitter -->
    <button
      id="twitter-share-button"
      class="px-3 py-1.5 bg-[#1DA1F2] text-white text-sm rounded-lg hover:bg-[#0c85d0] flex items-center space-x-1.5 transition-colors"
      title="Share on Twitter"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        ><path
          d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-.424.728-.666 1.581-.666 2.477 0 1.69.86 3.18 2.17 4.05-.79-.025-1.533-.242-2.18-.598v.055c0 2.36 1.67 4.32 3.89 4.77-.405.11-.83.17-1.26.17-.31 0-.61-.03-.91-.086.62 1.93 2.42 3.33 4.56 3.37-1.66.13-3.71.21-5.54.21-.36 0-.71-.02-1.06-.06 2.15 1.38 4.7 2.18 7.45 2.18 8.91 0 13.8-7.41 13.8-13.83 0-.21 0-.42-.02-.63.95-.69 1.77-1.55 2.42-2.51z"
        ></path></svg
      >
      <span>Share on Twitter</span>
    </button>
    <!-- Facebook -->
    <button
      id="facebook-share-button"
      class="px-3 py-1.5 bg-[#1877F2] text-white text-sm rounded-lg hover:bg-[#1158b2] flex items-center space-x-1.5 transition-colors"
      title="Share on Facebook"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="currentColor"
        viewBox="0 0 24 24"
        ><path
          d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
        ></path></svg
      >
      <span>Share on Facebook</span>
    </button>
    <!-- Copy Link -->
    <button
      id="copy-link-button"
      class="px-3 py-1.5 bg-gray-500 text-white text-sm rounded-lg hover:bg-gray-600 flex items-center space-x-1.5 transition-colors"
      title="Copy Link"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
        ></path></svg
      >
      <span>Copy Link</span>
    </button>
  </div>
</Layout>

<script define:vars={{ badge, linkedInShareBaseUrl }}>
  const linkedInButton = document.getElementById("linkedin-share-button");
  const twitterButton = document.getElementById("twitter-share-button");
  const facebookButton = document.getElementById("facebook-share-button");
  const copyLinkButton = document.getElementById("copy-link-button");

  const shareUrl = `${window.location.origin}/badges/${badge.id}`;
  const encodedUrl = encodeURIComponent(shareUrl);
  const badgeName = badge.metadata?.badgeName || "Achievement Badge";
  const badgeDesc = badge.metadata?.badgeDescription || "I earned a badge!";
  const twitterText = encodeURIComponent(
    `I just earned the '${badgeName}' badge on the DifferenTest platform! 🎉 Earn your own at DifferenTest.club. ${shareUrl}`
  );

  if (linkedInButton) {
    linkedInButton.addEventListener("click", () => {
      const title = encodeURIComponent(badgeName);
      const summary = encodeURIComponent(badgeDesc);
      window.open(
        `${linkedInShareBaseUrl}?url=${encodedUrl}&title=${title}&summary=${summary}`,
        "_blank"
      );
    });
  }

  if (twitterButton) {
    twitterButton.addEventListener("click", () => {
      window.open(
        `https://twitter.com/intent/tweet?text=${twitterText}`,
        "_blank"
      );
    });
  }

  if (facebookButton) {
    facebookButton.addEventListener("click", () => {
      window.open(
        `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
        "_blank"
      );
    });
  }

  if (copyLinkButton) {
    copyLinkButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        // Optional: Provide feedback to the user
        const originalText = copyLinkButton.innerHTML;
        copyLinkButton.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>'; // Checkmark icon
        copyLinkButton.title = "Copied!";
        setTimeout(() => {
          copyLinkButton.innerHTML = originalText;
          copyLinkButton.title = "Copy Link";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy link: ", err);
        alert("Failed to copy link. Please copy it manually.");
      }
    });
  }
</script>
