---
import Layout from "../../layouts/MainLayout.astro";
import FirebaseService from "../../lib/firebaseService";

export async function getStaticPaths() {
  try {
    // Get all badges using FirebaseService
    const badges = await FirebaseService.getAllBadges();

    // Return paths for each badge using the document ID
    return badges.map((badge) => ({
      params: { id: badge.id },
      props: { badge },
    }));
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [];
  }
}

const { id } = Astro.params;
const badge = await FirebaseService.getBadge(id);
---

<Layout title="Verify Badge">
  <main class="container mx-auto px-4 py-8">
    {
      badge ? (
        <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6">
          <h1 class="text-2xl font-bold mb-4">Badge Verification</h1>

          <div class="mb-6">
            <h2 class="text-xl font-semibold mb-2">{badge.name}</h2>
            <p class="text-gray-600 mb-4">{badge.description}</p>

            {badge.image && (
              <img
                src={badge.image}
                alt={badge.name}
                class="w-32 h-32 object-contain mx-auto mb-4"
              />
            )}
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
              <h3 class="font-semibold mb-2">Issuer</h3>
              <p class="text-gray-600">{badge.issuer.name}</p>
              <p class="text-gray-600">{badge.issuer.email}</p>
            </div>

            <div>
              <h3 class="font-semibold mb-2">Recipient</h3>
              <p class="text-gray-600">{badge.recipient.identity}</p>
            </div>

            <div>
              <h3 class="font-semibold mb-2">Issued On</h3>
              <p class="text-gray-600">
                {new Date(badge.issuedOn).toLocaleDateString()}
              </p>
            </div>

            <div>
              <h3 class="font-semibold mb-2">Evidence</h3>
              <p class="text-gray-600">{badge.evidence.narrative}</p>
            </div>
          </div>

          <div class="text-center">
            <a
              href={`/api/badges/${id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors"
            >
              Verify Badge
            </a>
          </div>
        </div>
      ) : (
        <div class="text-center">
          <h1 class="text-2xl font-bold mb-4">Badge Not Found</h1>
          <p class="text-gray-600">
            The badge you are looking for does not exist or has been removed.
          </p>
        </div>
      )
    }
  </main>
</Layout>
