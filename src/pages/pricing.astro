---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Pricing">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Simple, Transparent Pricing
      </h1>
      <p class="text-xl text-gray-600">Choose the plan that's right for you</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Free Plan -->
      <div
        class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-gray-200"
      >
        <div class="p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Free</h2>
          <p class="text-4xl font-bold text-gray-900 mb-4">
            $0<span class="text-lg font-normal text-gray-600">/forever</span>
          </p>
          <p class="text-gray-600 mb-6">
            Perfect for individual teachers and students
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Unlimited quizzes and classes
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Digital badges and achievements
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Basic analytics and reporting
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Community support
            </li>
          </ul>
          <a
            href="/signup"
            class="block w-full py-3 px-4 text-center bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors"
          >
            Get Started
          </a>
        </div>
      </div>

      <!-- Platinum Plan -->
      <div
        class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-primary-500 relative"
      >
        <div
          class="absolute top-0 right-0 bg-primary-500 text-white px-4 py-1 text-sm font-medium rounded-bl-lg"
        >
          Custom Solution
        </div>
        <div class="p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Platinum</h2>
          <p class="text-4xl font-bold text-gray-900 mb-4">Contact Us</p>
          <p class="text-gray-600 mb-6">
            Enterprise-grade solutions with custom development
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Custom design and branding
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              White-label web experience
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Custom curriculum development
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Dedicated support and training
            </li>
            <li class="flex items-center">
              <svg
                class="h-5 w-5 text-green-500 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Advanced analytics and reporting
            </li>
          </ul>
          <a
            href="/contact"
            class="block w-full py-3 px-4 text-center bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors"
          >
            Contact Sales
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
        Frequently Asked Questions
      </h2>
      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-medium text-gray-900">
            What's included in the Free plan?
          </h3>
          <p class="mt-2 text-gray-600">
            The Free plan includes all core features needed for creating and
            managing quizzes, classes, and issuing digital badges. It's perfect
            for individual teachers and students who want to get started with
            differentiated assessments.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-medium text-gray-900">
            What kind of custom solutions do you offer?
          </h3>
          <p class="mt-2 text-gray-600">
            Our Platinum plan offers custom design services, white-label
            solutions, and curriculum development tailored to your specific
            needs. We work closely with you to create a unique learning
            experience that aligns with your brand and educational goals.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-medium text-gray-900">
            How do I get started with the Platinum plan?
          </h3>
          <p class="mt-2 text-gray-600">
            Contact our sales team to discuss your specific requirements. We'll
            work with you to create a custom solution that meets your needs and
            budget.
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
