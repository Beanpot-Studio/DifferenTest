---
import Layout from "../layouts/MainLayout.astro";
import CurriculumCard from "../components/CurriculumCard.vue";

// Static stub data for development
const curricula = [
  {
    id: "1",
    title: "Introduction to Web Development",
    description: "Learn the basics of HTML, CSS, and JavaScript",
    isPublic: true,
    quizzes: [
      { id: "q1", title: "HTML Basics" },
      { id: "q2", title: "CSS Fundamentals" },
    ],
    createdAt: new Date(),
    updatedAt: new Date(),
  },
  {
    id: "2",
    title: "Advanced JavaScript",
    description: "Deep dive into modern JavaScript concepts",
    isPublic: true,
    quizzes: [
      { id: "q3", title: "ES6 Features" },
      { id: "q4", title: "Async Programming" },
    ],
    createdAt: new Date(),
    updatedAt: new Date(),
  },
];
---

<Layout title="Curricula">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Available Curricula</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        curricula.map((curriculum) => (
          <CurriculumCard client:load curriculum={curriculum} />
        ))
      }
    </div>
  </main>
</Layout>
