---
import MainLayout from "../layouts/MainLayout.astro";
import CurriculumCard from "../components/CurriculumCard.vue";
import FirebaseService from "../lib/firebaseService";

const baseUrl = import.meta.env.BASE_URL || "";

// Fetch public classes from Firebase
const publicClasses = await FirebaseService.getPublicClasses();
---

<MainLayout title="Curriculum">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Open Classes</h1>
    <div class="grid grid-cols-1 gap-6">
      {
        publicClasses.map((classData) => (
          <div class="bg-white rounded-lg shadow-md p-6">
            <CurriculumCard
              client:load
              curriculum={{
                id: classData.id,
                title: classData.name,
                teacherName: classData.teacherName,
                teacherId: classData.teacherId,
                code: classData.code,
                quizzes: classData.quizzes.map((quiz) => ({
                  ...quiz,
                  teacherId: classData.teacherId,
                  link: `${baseUrl}/classes/${classData.id}/quiz/${quiz.id}`,
                })),
              }}
              basePath={`${baseUrl}/classes`}
            />
          </div>
        ))
      }
    </div>
  </main>
</MainLayout>
