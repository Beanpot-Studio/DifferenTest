---
import Layout from "../layouts/MainLayout.astro";
import CurriculumCard from "../components/CurriculumCard.vue";
import FirebaseService from "../lib/firebaseService";

// Fetch public classes from Firebase
const publicClasses = await FirebaseService.getPublicClasses();
---

<Layout title="Curriculum">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Free Classes</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
      {
        publicClasses.map((classData) => (
          <CurriculumCard
            client:load
            curriculum={{
              id: classData.id,
              title: classData.name,
              teacherName: classData.teacherName,
              code: classData.code,
              quizzes: classData.quizzes.map((quiz) => ({
                id: quiz.id,
                title: quiz.title || `Quiz ${quiz.id}`,
                lessonPlan: quiz.lessonPlan || "",
                link: `/quizzes/${quiz.id}`,
              })),
              link: `/classes/${classData.id}`,
            }}
          />
        ))
      }
    </div>
  </main>
</Layout>
