---
import MainLayout from "../layouts/MainLayout.astro";
import CurriculumCard from "../components/CurriculumCard.vue";
import FirebaseService from "../lib/firebaseService";
import IconService from "../components/services/IconService.vue";

interface Quiz {
  id: string;
  title: string;
  description?: string;
  badgeImage?: string;
}

interface ClassData {
  id: string;
  name: string;
  teacherName: string;
  teacherId: string;
  code: string;
  quizzes: Quiz[];
}

// Class image mappings
const CLASS_IMAGES: Record<string, { banner: string; description: string }> = {
  DCEBjGMJurMxtaFMuBUJ: {
    banner: "/acatemy-banner.png",
    description:
      "Designed for kids in grades 1-3, a gentle introduction to Artificial Intelligence, hosted by cheerful cats! Join the aCATemy now for free and earn badges and a certificate.",
  },
  s150MQygG0PwnUPSsZUJ: {
    banner: "/webdev-banner.png",
    description:
      "Learn the fundamentals of web development with our comprehensive project-based curriculum covering HTML, CSS, and JavaScript basics.",
  },
  H7UpZF3KEg2JvV3WffYW: {
    banner: "/nsvue-banner.png",
    description:
      "Build a mobile app with NativeScript and Vue.js in this workshop.",
  },
};

const publicClasses = await FirebaseService.getPublicClasses() as ClassData[];
---

<MainLayout title="Curriculum">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center text-secondary-900 mb-12">Open Curricula</h1>
    
    <div class="space-y-6 max-w-4xl mx-auto">
      {
        publicClasses.map((classData) => {
          const classInfo = CLASS_IMAGES[classData.id] || {
            banner: "/webdev-banner.png",
            description: "Learn with DifferenTest",
          };
          
          return (
            <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-gray-200">
              <!-- Banner Section -->
              <div 
                class="relative cursor-pointer"
                data-class-id={classData.id}
                onclick="const classId = this.getAttribute('data-class-id'); const content = document.getElementById(`class-content-${classId}`); const toggle = document.getElementById(`toggle-${classId}`); const icon = toggle.querySelector('svg'); content.classList.toggle('hidden'); toggle.setAttribute('aria-expanded', content.classList.contains('hidden') ? 'false' : 'true'); icon.style.transform = content.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';"
              >
                <img
                  src={classInfo.banner}
                  alt={classInfo.description}
                  class="w-full h-48 object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-6">
                  <h2 class="text-3xl font-bold text-white mb-2">{classData.name}</h2>
                  <p class="text-white/90 text-lg max-w-2xl">{classInfo.description}</p>
                </div>
              </div>

              <!-- Toggle Button -->
              <button
                id={`toggle-${classData.id}`}
                class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500"
                aria-expanded="false"
                aria-controls={`class-content-${classData.id}`}
              >
                <div class="flex items-center space-x-3">
                  <IconService
                    name="user"
                    size="5"
                    color="text-gray-400"
                  />
                  <span class="text-gray-600">Created by {classData.teacherName}</span>
                </div>
                <svg
                  class="w-6 h-6 text-gray-500 transform transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>

              <!-- Collapsible Content -->
              <div
                id={`class-content-${classData.id}`}
                class="hidden px-6 py-4 border-t border-gray-200"
              >
                <CurriculumCard
                  client:load
                  curriculum={{
                    id: classData.id,
                    title: classData.name,
                    teacherName: classData.teacherName,
                    teacherId: classData.teacherId,
                    code: classData.code,
                    quizzes: classData.quizzes.map((quiz) => ({
                      ...quiz,
                      teacherId: classData.teacherId,
                      link: `/courses/${classData.id}/quiz/${quiz.id}`,
                      onclick: `event.preventDefault(); window.open('/courses/${classData.id}/quiz/${quiz.id}', 'quiz_${classData.id}_${quiz.id}', 'width=900,height=700,resizable=yes,scrollbars=yes,status=yes');`
                    })),
                  }}
                  basePath='/courses'
                />
              </div>
            </div>
          );
        })
      }
    </div>
  </main>
</MainLayout>

<script>
  // Add click handlers for the collapsible panels
  document.querySelectorAll("button[aria-expanded]").forEach((button) => {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      const content = document.getElementById(
        button.getAttribute("aria-controls")!
      );
      const icon = button.querySelector("svg");

      // Toggle expanded state
      button.setAttribute("aria-expanded", (!isExpanded).toString());

      // Toggle content visibility
      if (content) {
        content.classList.toggle("hidden");
      }

      // Rotate icon
      if (icon) {
        icon.style.transform = isExpanded ? "rotate(0deg)" : "rotate(180deg)";
      }
    });
  });

  // Add visual feedback for banner hover
  document.querySelectorAll(".relative.cursor-pointer").forEach((banner) => {
    const bannerElement = banner as HTMLElement;
    bannerElement.addEventListener("mouseenter", () => {
      bannerElement.style.opacity = "0.95";
    });
    bannerElement.addEventListener("mouseleave", () => {
      bannerElement.style.opacity = "1";
    });
  });
</script>
