---
import MainLayout from "../layouts/MainLayout.astro";
import CurriculumCard from "../components/CurriculumCard.vue";
import FirebaseService from "../lib/firebaseService";

interface Quiz {
  id: string;
  title: string;
  description?: string;
  badgeImage?: string;
}

interface ClassData {
  id: string;
  name: string;
  teacherName: string;
  teacherId: string;
  code: string;
  quizzes: Quiz[];
}

// Class image mappings
const CLASS_IMAGES: Record<string, { home: string; description: string }> = {
  DCEBjGMJurMxtaFMuBUJ: {
    home: "/acatemy-home.png",
    description:
      "Designed for kids in grades 1-3, a gentle introduction to Artificial Intelligence, hosted by cheerful cats! Join the aCATemy now for free and earn badges and a certificate.",
  },
  s150MQygG0PwnUPSsZUJ: {
    home: "/webdev-home.png",
    description:
      "Learn the fundamentals of web development with our comprehensive project-based curriculum covering HTML, CSS, and JavaScript basics.",
  },
  H7UpZF3KEg2JvV3WffYW: {
    home: "/nsvue-home.png",
    description:
      "Build a mobile app with NativeScript and Vue.js in this workshop.",
  },
};

const publicClasses = (await FirebaseService.getPublicClasses()) as ClassData[];
---

<MainLayout title="Curriculum">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center text-secondary-900 mb-12">
      Open Classes
    </h1>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto"
    >
      {
        publicClasses.map((classData) => {
          const classInfo = CLASS_IMAGES[classData.id] || {
            home: "/webdev-home.png",
            description: "Learn with DifferenTest",
          };

          return (
            <a
              href={`/openclasses/${classData.id}`}
              class="block bg-white rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-200 group h-full"
            >
              <div class="p-6 flex flex-col h-full">
                <div class="flex space-x-2 mb-4">
                  <div class="flex items-center justify-center text-sm text-gray-500 w-full">
                    <img
                      src={classInfo.home}
                      alt={classInfo.description}
                      class="rounded-lg w-full object-contain"
                    />
                  </div>
                </div>
                <h3 class="text-2xl font-semibold text-primary-700 mb-3 group-hover:text-primary-800">
                  {classData.name}
                </h3>
                <p class="text-secondary-700 mb-4 flex-grow">
                  {classInfo.description}
                </p>
                <div class="flex items-center text-sm text-gray-500 mb-4">
                  <span>Teacher: {classData.teacherName}</span>
                </div>
                <button class="inline-block bg-primary-600 text-white font-medium py-2 px-5 rounded-lg group-hover:bg-primary-700 transition-colors w-full">
                  Start Learning for Free
                </button>
              </div>
            </a>
          );
        })
      }
    </div>
  </main>
</MainLayout>

<script>
  // Add click handlers for the collapsible panels
  document.querySelectorAll("button[aria-expanded]").forEach((button) => {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      const content = document.getElementById(
        button.getAttribute("aria-controls")!
      );
      const icon = button.querySelector("svg");

      // Toggle expanded state
      button.setAttribute("aria-expanded", (!isExpanded).toString());

      // Toggle content visibility
      if (content) {
        content.classList.toggle("hidden");
      }

      // Rotate icon
      if (icon) {
        icon.style.transform = isExpanded ? "rotate(0deg)" : "rotate(180deg)";
      }
    });
  });
</script>
