---
import Layout from "../../layouts/MainLayout.astro";
import FirebaseService from "../../lib/firebaseService.js";
import type { Timestamp } from "firebase/firestore";

// Define an interface for the expected certificate structure
interface CertificateData {
  id: string;
  userId: string;
  studentName?: string;
  classId: string;
  className?: string;
  teacherId?: string;
  teacherName?: string;
  quizIds?: string[];
  claimedAt?: Timestamp | Date; // Allow both Firestore Timestamp and converted Date
  badgeImageUrl?: string;
  // Add other expected fields if necessary
}

export async function getStaticPaths() {
  try {
    // Assume getAllCertificates returns objects matching CertificateData (or close enough)
    const certificates = await FirebaseService.getAllCertificates();
    return certificates.map((cert) => ({
      params: { id: cert.id },
      props: { certificate: cert as CertificateData }, // Cast to help TS
    }));
  } catch (error) {
    console.error("Error generating certificate paths:", error);
    return [];
  }
}

// Explicitly type Astro.props
interface Props {
  certificate: CertificateData;
}
const { certificate } = Astro.props as Props;

if (!certificate) {
  return new Response(null, {
    status: 404,
    statusText: "Certificate Data Not Found in Props",
  });
}

// Use the typed certificate object
const studentName = certificate.studentName || "Student Name";
const className = certificate.className || "Class Name";
const teacherName = certificate.teacherName || "Instructor";
// Handle potential Date or Timestamp object for claimedAt
const claimedDate = certificate.claimedAt
  ? (certificate.claimedAt instanceof Date
      ? certificate.claimedAt
      : certificate.claimedAt.toDate()
    ).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "Date Not Available";
const pageUrl = Astro.url.href;
const certificateHtmlId = "certificate-to-print";
const badgeImageUrl = certificate.badgeImageUrl;

// Adjusted meta tags to use direct properties
const pageTitle = `Certificate: ${className}`;
// Keep description simple for now, as it wasn't a valid Layout prop
// const pageDescription = `Certificate of completion for ${className} issued to ${studentName}.`;
// const pageImage = ''

// LinkedIn sharing function (will be used in client-side script)
const linkedInShareBaseUrl = "https://www.linkedin.com/sharing/share-offsite/";
---

<Layout
  title={pageTitle}
  metaTags={[
    { property: "og:title", content: pageTitle },
    { property: "og:url", content: pageUrl },
    { property: "og:type", content: "website" },
    { property: "og:image:width", content: "500" },
    { property: "og:image:height", content: "500" },
    // Add Twitter card tags for better sharing on Twitter
    { name: "twitter:card", content: "summary_large_image" },
    { name: "twitter:title", content: pageTitle },
  ]}
>
  <main class="container mx-auto px-4 py-8">
    <!-- Download Button (Moved Top Right) -->
    <div class="max-w-4xl mx-auto mb-4 flex justify-end">
      <button
        id="download-pdf-btn"
        class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition duration-300 flex items-center gap-1"
        title="Download Certificate as PDF"
      >
        Download Certificate
      </button>
    </div>

    <div
      class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-xl border-4 border-blue-200"
    >
      <!-- Certificate Content -->
      <div
        id={certificateHtmlId}
        class="certificate-content relative bg-gradient-to-br from-blue-50 to-indigo-100 p-8 pt-8 border-2 border-dashed border-blue-400"
      >
        <div class="text-center mb-8">
          <h1 class="text-3xl font-bold text-blue-800 mb-2 font-serif">
            Certificate of Completion
          </h1>
          <p class="text-lg text-gray-600">
            This certificate is proudly presented to
          </p>
        </div>

        <div class="text-center mb-8">
          <p
            class="text-4xl font-semibold text-primary-700 tracking-wide font-cursive"
          >
            {studentName}
          </p>
          <hr class="my-4 border-t-2 border-blue-300 w-1/2 mx-auto" />
        </div>

        <div class="text-center mb-8">
          <p class="text-lg text-gray-600 mb-2">
            For successfully completing the class
          </p>
          <p class="text-3xl font-medium text-gray-800">{className}</p>
        </div>

        <!-- Signatures and Badge Row -->
        <div class="flex justify-around items-end mt-8 text-sm text-gray-500">
          <!-- Teacher Signature -->
          <div class="text-center">
            <p class="font-semibold border-t border-gray-400 pt-1">
              {teacherName}
            </p>
            <p>Instructor</p>
          </div>

          <!-- Badge Image -->
          <div class="flex flex-col items-center mx-4">
            {
              badgeImageUrl && (
                <img
                  src={badgeImageUrl}
                  alt="Certificate Badge"
                  class="h-32 opacity-90 mb-2"
                />
              )
            }
            {
              !badgeImageUrl && (
                <img
                  src="/certification-badge.png"
                  alt="Default Certificate Badge"
                  class="h-32 opacity-90 mb-2"
                />
              )
            }
            <p class="text-xs text-gray-400">presented by DifferenTest.club</p>
          </div>

          <!-- Date Issued -->
          <div class="text-center">
            <p class="font-semibold border-t border-gray-400 pt-1">
              {claimedDate}
            </p>
            <p>Date Issued</p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div
        class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-4"
      >
        <!-- Social Share Buttons Row -->
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <!-- LinkedIn -->
          <button
            id="linkedin-share-button"
            class="px-3 py-1.5 bg-[#0077b5] text-white text-sm rounded-lg hover:bg-[#005e90] flex items-center space-x-1.5 transition-colors"
            title="Share on LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"
              ></path></svg
            >
            <span>Share on LinkedIn</span>
          </button>
          <!-- Twitter -->
          <button
            id="twitter-share-button"
            class="px-3 py-1.5 bg-[#1DA1F2] text-white text-sm rounded-lg hover:bg-[#0c85d0] flex items-center space-x-1.5 transition-colors"
            title="Share on Twitter"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-.424.728-.666 1.581-.666 2.477 0 1.69.86 3.18 2.17 4.05-.79-.025-1.533-.242-2.18-.598v.055c0 2.36 1.67 4.32 3.89 4.77-.405.11-.83.17-1.26.17-.31 0-.61-.03-.91-.086.62 1.93 2.42 3.33 4.56 3.37-1.66.13-3.71.21-5.54.21-.36 0-.71-.02-1.06-.06 2.15 1.38 4.7 2.18 7.45 2.18 8.91 0 13.8-7.41 13.8-13.83 0-.21 0-.42-.02-.63.95-.69 1.77-1.55 2.42-2.51z"
              ></path></svg
            >
            <span>Share on Twitter</span>
          </button>
          <!-- Facebook -->
          <button
            id="facebook-share-button"
            class="px-3 py-1.5 bg-[#1877F2] text-white text-sm rounded-lg hover:bg-[#1158b2] flex items-center space-x-1.5 transition-colors"
            title="Share on Facebook"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
              ></path></svg
            >
            <span>Share on Facebook</span>
          </button>
          <!-- Copy Link -->
          <button
            id="copy-link-button"
            class="px-3 py-1.5 bg-gray-500 text-white text-sm rounded-lg hover:bg-gray-600 flex items-center space-x-1.5 transition-colors"
            title="Copy Link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
              ></path></svg
            >
            <span>Copy Link</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <style>
    /* Add custom fonts if needed */
    @import url("https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Merriweather:wght@400;700&display=swap");

    .font-serif {
      font-family: "Merriweather", serif;
    }
    .font-cursive {
      font-family: "Dancing Script", cursive;
    }

    /* Ensure content within the printable area looks good */
    .certificate-content {
      /* Add any specific styles for printing */
    }
    /* Add styles for button feedback */
    #copy-link-button.copied {
      background-color: #10b981; /* Tailwind green-500 */
      cursor: default;
    }
    #copy-link-button.copied svg {
      display: none; /* Hide original icon */
    }
    #copy-link-button.copied span::after {
      content: " ✔"; /* Add checkmark */
    }
  </style>

  <script define:vars={{ certificateHtmlId, className, studentName, pageUrl }}>
    // --- PDF Generation ---
    async function downloadPDF() {
      const element = document.getElementById(certificateHtmlId);
      if (!element) {
        console.error("Certificate element not found");
        alert("Could not find the certificate content to download.");
        return;
      }

      const filename = `${studentName.replace(/\\s+/g, "_")}_${className.replace(/\\s+/g, "_")}_Certificate.pdf`;

      const options = {
        margin: [1.0, 0.5, 0.25, 0.5], // Increased top margin for vertical centering
        filename: filename,
        image: { type: "jpeg", quality: 0.98 },
        html2canvas: {
          scale: 2,
          useCORS: true,
          logging: false,
          ignoreElements: (element) => {
            // Ignore script tags and known dev toolbar elements
            const tagName = element.tagName.toUpperCase();
            const id = element.id;
            return (
              tagName === "SCRIPT" ||
              tagName === "ASTRO-DEV-TOOLBAR" ||
              id === "vite-plugin-inspect"
            );
          },
        },
        jsPDF: { unit: "in", format: "letter", orientation: "landscape" }, // Landscape orientation is often better for certificates
      };

      // Add a temporary class for styling during PDF generation if needed
      element.classList.add("pdf-generating");

      try {
        // Disable button during generation
        const downloadBtn = document.getElementById("download-pdf-btn");
        if (downloadBtn) downloadBtn.disabled = true;

        await html2pdf().from(element).set(options).save();

        // Re-enable button
        if (downloadBtn) downloadBtn.disabled = false;
      } catch (err) {
        console.error("Error generating PDF:", err);
        alert("Failed to generate PDF. Please try again.");
        // Re-enable button on error
        if (downloadBtn) downloadBtn.disabled = false;
      } finally {
        element.classList.remove("pdf-generating"); // Remove temporary class
      }
    }

    document
      .getElementById("download-pdf-btn")
      .addEventListener("click", downloadPDF);

    // --- Social Sharing & Copy Link ---
    const linkedInButton = document.getElementById("linkedin-share-button");
    const twitterButton = document.getElementById("twitter-share-button");
    const facebookButton = document.getElementById("facebook-share-button");
    const copyLinkButton = document.getElementById("copy-link-button");

    const shareUrl = pageUrl; // Use the pageUrl passed from Astro
    const encodedUrl = encodeURIComponent(shareUrl);
    const certificateName = className || "Achievement Certificate";
    const twitterText = encodeURIComponent(
      `I earned the '${certificateName}' certificate on the DifferenTest platform for completing the ${className} class! 🎉 ${shareUrl}`
    );
    const linkedInShareBaseUrl =
      "https://www.linkedin.com/sharing/share-offsite/"; // Base URL for LinkedIn

    if (linkedInButton) {
      linkedInButton.addEventListener("click", () => {
        const title = encodeURIComponent(`Certificate: ${certificateName}`);
        // LinkedIn doesn't use summary/description in the same way, URL is key
        window.open(`${linkedInShareBaseUrl}?url=${encodedUrl}`, "_blank");
      });
    }

    if (twitterButton) {
      twitterButton.addEventListener("click", () => {
        window.open(
          `https://twitter.com/intent/tweet?text=${twitterText}`,
          "_blank"
        );
      });
    }

    if (facebookButton) {
      facebookButton.addEventListener("click", () => {
        window.open(
          `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
          "_blank"
        );
      });
    }

    if (copyLinkButton) {
      copyLinkButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(shareUrl);
          // Provide visual feedback
          const originalHTML = copyLinkButton.innerHTML;
          const originalTitle = copyLinkButton.title;
          copyLinkButton.innerHTML = "<span>Copied! ✔</span>"; // Replace content
          copyLinkButton.classList.add("copied");
          copyLinkButton.disabled = true;

          setTimeout(() => {
            copyLinkButton.innerHTML = originalHTML;
            copyLinkButton.classList.remove("copied");
            copyLinkButton.title = originalTitle;
            copyLinkButton.disabled = false;
          }, 2000); // Reset after 2 seconds
        } catch (err) {
          console.error("Failed to copy link: ", err);
          alert("Failed to copy link. Please copy it manually.");
        }
      });
    }
  </script>
</Layout>
