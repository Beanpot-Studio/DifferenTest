---
import MainLayout from "../../layouts/MainLayout.astro";
import RoleBasedContent from "../../components/RoleBasedContent.vue";
import StudentClasses from "../../components/StudentClasses.vue";
import ClassBrowser from "../../components/ClassBrowser.vue";
---

<MainLayout title="Student Portal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Student Portal</h1>
        <p class="mt-1 text-sm text-gray-500">
          Welcome back! Track your progress and continue learning.
        </p>
      </div>
      <div class="flex items-center space-x-3">
        <button
          class="px-4 py-2 bg-white text-gray-600 border rounded-lg hover:bg-gray-50 flex items-center space-x-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"
            ></path>
          </svg>
          <span>Sort</span>
        </button>
        <button
          id="joinClassBtn"
          class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 flex items-center space-x-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Join New Class</span>
        </button>
      </div>
    </div>

    <RoleBasedContent client:load>
      <div class="space-y-6">
        <!-- Class Browser Modal -->
        <ClassBrowser client:load />

        <!-- Learning Progress Overview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-3 bg-primary-100 rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-primary-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"
                  ></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900">
                  Active Classes
                </h3>
                <p
                  class="text-3xl font-bold text-primary-600"
                  id="activeClassesCount"
                >
                  0
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-3 bg-green-100 rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-green-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                  <path
                    fill-rule="evenodd"
                    d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm9.707 5.707a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900">
                  Completed Quizzes
                </h3>
                <p
                  class="text-3xl font-bold text-green-600"
                  id="completedQuizzesCount"
                >
                  0
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="flex items-center">
              <div class="p-3 bg-yellow-100 rounded-lg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-yellow-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900">
                  Average Score
                </h3>
                <p class="text-3xl font-bold text-yellow-600" id="averageScore">
                  0%
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Classes and Quizzes -->
        <StudentClasses client:load />

        <!-- Recent Activity -->
        <div class="bg-white rounded-xl shadow-sm p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">
            Recent Activity
          </h3>
          <div id="recentActivities" class="space-y-4">
            <div class="text-center py-4">
              <div
                class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600 mx-auto"
              >
              </div>
              <p class="mt-2 text-gray-500">Loading activities...</p>
            </div>
          </div>
          <div class="mt-4">
            <a
              href="#"
              class="text-sm font-medium text-primary-600 hover:text-primary-700"
            >
              View all activity →
            </a>
          </div>
        </div>
      </div>
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  // Client-side script for student portal
  import { onAuthStateChanged } from "firebase/auth";
  import {
    doc,
    getDoc,
    collection,
    query,
    where,
    getDocs,
    orderBy,
    limit,
  } from "firebase/firestore";
  import { auth, db } from "../../lib/firebase";

  // Format relative time
  const formatRelativeTime = (timestamp: any) => {
    const now = new Date();
    const then =
      typeof timestamp.toDate === "function"
        ? timestamp.toDate()
        : new Date(timestamp);
    const diffInSeconds = Math.floor((now.getTime() - then.getTime()) / 1000);

    if (diffInSeconds < 60) return "just now";
    if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)}m ago`;
    if (diffInSeconds < 86400)
      return `${Math.floor(diffInSeconds / 3600)}h ago`;
    if (diffInSeconds < 604800)
      return `${Math.floor(diffInSeconds / 86400)}d ago`;
    return then.toLocaleDateString();
  };

  // Update recent activities
  const updateRecentActivities = async (userId) => {
    try {
      const activitiesRef = collection(db, "activities");
      const activitiesQuery = query(
        activitiesRef,
        where("userId", "==", userId),
        orderBy("timestamp", "desc"),
        limit(5)
      );
      const activitiesSnapshot = await getDocs(activitiesQuery);

      const activitiesContainer = document.querySelector("#recentActivities");
      if (!activitiesContainer) return;

      if (activitiesSnapshot.empty) {
        activitiesContainer.innerHTML = `
          <div class="text-center py-8">
            <p class="text-gray-500">No recent activity</p>
          </div>
        `;
        return;
      }

      const activitiesHTML = await Promise.all(
        activitiesSnapshot.docs.map(async (doc) => {
          const activity = doc.data();
          let icon, title, subtitle;

          switch (activity.type) {
            case "class_joined":
              icon = `<div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>`;
              title = `Joined New Class: ${activity.className}`;
              subtitle = `Prof. ${activity.teacherName}`;
              break;
            case "quiz_completed":
              icon = `<div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>`;
              title = `Completed Quiz: ${activity.quizName}`;
              subtitle = `Score: ${activity.score}% · ${activity.className} · ${activity.quizTitle}`;
              break;
            case "quiz_started":
              icon = `<div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>`;
              title = `Started New Quiz: ${activity.quizName}`;
              subtitle = activity.className;
              break;
            default:
              return "";
          }

          return `
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              ${icon}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900">${title}</p>
              <p class="text-sm text-gray-500">${subtitle}</p>
            </div>
            <div class="flex-shrink-0 text-sm text-gray-500">
              ${formatRelativeTime(activity.timestamp)}
            </div>
          </div>
        `;
        })
      );

      activitiesContainer.innerHTML = `
        <div class="space-y-4">
          ${activitiesHTML.join("")}
        </div>
      `;
    } catch (error) {
      console.error("Error updating activities:", error);
    }
  };

  // Update dashboard stats
  const updateDashboardStats = async (userId) => {
    try {
      // Update active classes count
      const enrollmentsRef = collection(db, "enrollments");
      const enrollmentsQuery = query(
        enrollmentsRef,
        where("userId", "==", userId)
      );
      const enrollmentsSnapshot = await getDocs(enrollmentsQuery);

      const activeClassesElement =
        document.getElementById("activeClassesCount");
      if (activeClassesElement) {
        activeClassesElement.textContent = String(enrollmentsSnapshot.size);
      }

      // Get quiz attempts
      const attemptsRef = collection(db, "quizAttempts");
      const attemptsQuery = query(attemptsRef, where("userId", "==", userId));
      const attemptsSnapshot = await getDocs(attemptsQuery);

      // Update completed quizzes count
      const completedQuizzes = attemptsSnapshot.docs.length;
      const completedQuizzesElement = document.getElementById(
        "completedQuizzesCount"
      );
      if (completedQuizzesElement) {
        completedQuizzesElement.textContent = String(completedQuizzes);
      }

      // Calculate average score
      if (completedQuizzes > 0) {
        const totalScore = attemptsSnapshot.docs.reduce(
          (sum, doc) => sum + doc.data().score,
          0
        );
        const averageScore = Math.round(totalScore / completedQuizzes);
        const averageScoreElement = document.getElementById("averageScore");
        if (averageScoreElement) {
          averageScoreElement.textContent = `${averageScore}%`;
        }
      }
    } catch (error) {
      console.error("Error updating dashboard stats:", error);
    }
  };

  // This script will handle authentication and update dashboard stats
  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = "/?auth=required";
      return;
    }

    try {
      const userDoc = await getDoc(doc(db, "users", user.uid));

      if (userDoc.exists()) {
        const role = userDoc.data().role;
        if (role !== "student") {
          window.location.href = "/dashboard?access=denied";
          return;
        }

        // Initial updates
        await updateDashboardStats(user.uid);
        await updateRecentActivities(user.uid);

        // Listen for class joined events
        window.addEventListener("classJoined", async () => {
          // Update all components
          await updateDashboardStats(user.uid);
          await updateRecentActivities(user.uid);

          // Trigger StudentClasses component update
          const studentClassesComponent =
            document.querySelector("student-classes");
          if (studentClassesComponent) {
            studentClassesComponent.dispatchEvent(
              new CustomEvent("refreshClasses")
            );
          }
        });
      }
    } catch (error) {
      console.error("Error checking user role:", error);
    }
  });
</script>
