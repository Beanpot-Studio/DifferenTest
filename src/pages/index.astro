---
import MainLayout from "../layouts/MainLayout.astro";
import HomeCTA from "../components/HomeCTA.vue";
import UserInfo from "../components/UserInfo.vue";
---

<MainLayout title="Welcome">
  <section class="py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
        Welcome to DifferenTest
      </h1>

      <!-- User Info -->
      <div class="max-w-5xl mx-auto mb-8">
        <UserInfo client:load />
      </div>

      <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
        Assessments, Testing, and Credentialing can be way better.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- For Teachers -->
      <div
        class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
      >
        <div class="p-6">
          <div
            class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-secondary-900 mb-2">
            For Teachers
          </h2>
          <p class="text-secondary-600 mb-4">
            Build assessments and track student progress all in one place.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Create and manage courses
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Assign and grade work
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Track student performance
            </li>
          </ul>
          <a
            href="/teacher"
            class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
          >
            Teacher Portal
          </a>
        </div>
      </div>

      <!-- For Students -->
      <div
        class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
      >
        <div class="p-6">
          <div
            class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
              <path
                d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-secondary-900 mb-2">
            For Students
          </h2>
          <p class="text-secondary-600 mb-4">
            Access and complete your assignments and communicate with your
            teachers easily.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Access course materials
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Submit assignments
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Track your progress
            </li>
          </ul>
          <a
            href="/student"
            class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
          >
            Student Portal
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-12 bg-secondary-100 rounded-lg mt-12">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-secondary-900">
        Why Choose DifferenTest?
      </h2>
      <p class="text-lg text-secondary-600 mt-2">
        Our platform is designed to make education more accessible and
        efficient.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto px-4">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div
          class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-green-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2">Save Time</h3>
        <p class="text-secondary-600">
          Streamline administrative tasks and focus on what matters: teaching
          and learning.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <div
          class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-primary-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2">Better Communication</h3>
        <p class="text-secondary-600">
          Facilitate communication between teachers and students through our
          integrated platform.
        </p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <div
          class="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-purple-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-2">Track Progress</h3>
        <p class="text-secondary-600">
          Monitor learning progress with intuitive analytics and reporting
          tools.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 mt-12 bg-accent-600 rounded-lg text-white text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
    <p class="text-lg text-primary-100 mb-8 max-w-2xl mx-auto">
      Join thousands of teachers and students already using DifferenTest to
      transform their educational experience.
    </p>
    <HomeCTA client:load />
  </section>
</MainLayout>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc } from "firebase/firestore";
  import { auth, db } from "../lib/firebase";

  // This script will redirect non-student users away from this page
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      try {
        const userDoc = await getDoc(doc(db, "users", user.uid));

        if (userDoc.exists()) {
          const role = userDoc.data().role;

          // Get portal buttons
          const teacherPortal = document.querySelector('a[href="/teacher"]');
          const studentPortal = document.querySelector('a[href="/student"]');

          if (teacherPortal && studentPortal) {
            if (role === "student") {
              // Disable teacher portal for students
              teacherPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.setAttribute("aria-disabled", "true");
              teacherPortal.setAttribute(
                "title",
                "Only available for teachers"
              );

              // Enable student portal
              studentPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.removeAttribute("aria-disabled");
            } else if (role === "teacher") {
              // Enable teacher portal
              teacherPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.removeAttribute("aria-disabled");

              // Disable student portal for teachers
              studentPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.setAttribute("aria-disabled", "true");
              studentPortal.setAttribute(
                "title",
                "Only available for students"
              );
            }
          }
        }
      } catch (error) {
        console.error("Error checking user role:", error);
      }
    } else {
      // If no user is logged in, disable both portals
      const portals = document.querySelectorAll(
        'a[href="/teacher"], a[href="/student"]'
      );
      portals.forEach((portal) => {
        portal.classList.add(
          "pointer-events-none",
          "opacity-50",
          "cursor-not-allowed"
        );
        portal.setAttribute("aria-disabled", "true");
        portal.setAttribute("title", "Please log in to access portals");
      });
    }
  });
</script>
