---
import MainLayout from "../layouts/MainLayout.astro";
import HomeCTA from "../components/HomeCTA.vue";
import UserInfo from "../components/UserInfo.vue";
---

<MainLayout title="Welcome">
  <section class="py-5">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
        Welcome to DifferenTest
      </h1>

      <!-- User Info -->
      <div class="max-w-5xl mx-auto mb-8">
        <UserInfo client:load />
      </div>

      <h2 class="text-3xl font-bold text-secondary-900">
        Assessments, Testing, and Credentialing can be way better.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- For Teachers -->
      <div
        class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
      >
        <div class="p-6">
          <div
            class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-secondary-900 mb-2">
            For Teachers
          </h2>
          <p class="text-secondary-600 mb-4">
            Upload lesson plans and autogenerate editable assessments. Track
            student progress all in one place.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Create and manage courses
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Assign auto-graded differentiated tests
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Track student performance
            </li>
          </ul>
          <a
            href="/teacher"
            class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
          >
            Teacher Portal
          </a>
        </div>
      </div>

      <!-- For Students -->
      <div
        class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
      >
        <div class="p-6">
          <div
            class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-secondary-900 mb-2">
            For Students
          </h2>
          <p class="text-secondary-600 mb-4">
            Access and complete your assignments and communicate with your
            teachers easily.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Access course materials
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Submit assignments
            </li>
            <li class="flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-green-500 mr-2"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              Track your progress
            </li>
          </ul>
          <a
            href="/student"
            class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
          >
            Student Portal
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-16 bg-secondary-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Feature 1 -->
        <div class="text-center">
          <div
            class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Smart Quiz Generation</h3>
          <p class="text-secondary-600">
            Generate quizzes automatically from your lesson content using AI
            technology.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="text-center">
          <div
            class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Progress Tracking</h3>
          <p class="text-secondary-600">
            Monitor student performance and progress with detailed analytics and
            insights.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="text-center">
          <div
            class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Instant Feedback</h3>
          <p class="text-secondary-600">
            Get immediate results and detailed explanations for better learning
            outcomes.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="text-center">
          <div
            class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Micro-credentialing</h3>
          <p class="text-secondary-600">
            Students can earn stackable credentials and certificates via
            blockchain-verified achievements.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 mt-12 bg-primary-600 rounded-lg text-white text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
    <p class="text-lg text-primary-100 mb-8 max-w-2xl mx-auto">
      Join thousands of teachers and students already using DifferenTest to
      transform their educational experience.
    </p>
    <HomeCTA client:load />
  </section>

  <!-- About Section -->
  <section id="about" class="py-16 bg-secondary-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">About DifferenTest</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 1 -->
        <div class="text-center">
          <h3 class="text-xl font-bold mb-2">
            Students Supported, Teachers in Control
          </h3>
          <p class="text-secondary-600">
            Students can access their assessments and progress at any time, from
            any device and communicate with their instructors safely and
            securely. Teachers have full control over building their AI-assisted
            assessments and can easily edit them.
          </p>
        </div>

        <!-- 2 -->
        <div class="text-center">
          <h3 class="text-xl font-bold mb-2">Cutting-Edge Technology</h3>
          <p class="text-secondary-600">
            DifferenTest uses AI to generate differentiated assessments with a
            clear pathway for students, based on a teacher's documented learning
            objectives. Micro-credentialing, stacking to a full credential are
            supported via blockchain.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc } from "firebase/firestore";
  import { auth, db } from "../lib/firebase";

  // This script will redirect non-student users away from this page
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      try {
        const userDoc = await getDoc(doc(db, "users", user.uid));

        if (userDoc.exists()) {
          const role = userDoc.data().role;

          // Get portal buttons
          const teacherPortal = document.querySelector('a[href="/teacher"]');
          const studentPortal = document.querySelector('a[href="/student"]');

          if (teacherPortal && studentPortal) {
            if (role === "student") {
              // Disable teacher portal for students
              teacherPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.setAttribute("aria-disabled", "true");
              teacherPortal.setAttribute(
                "title",
                "Only available for teachers"
              );

              // Enable student portal
              studentPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.removeAttribute("aria-disabled");
            } else if (role === "teacher") {
              // Enable teacher portal
              teacherPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.removeAttribute("aria-disabled");

              // Disable student portal for teachers
              studentPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.setAttribute("aria-disabled", "true");
              studentPortal.setAttribute(
                "title",
                "Only available for students"
              );
            }
          }
        }
      } catch (error) {
        console.error("Error checking user role:", error);
      }
    } else {
      // If no user is logged in, disable both portals
      const portals = document.querySelectorAll(
        'a[href="/teacher"], a[href="/student"]'
      );
      portals.forEach((portal) => {
        portal.classList.add(
          "pointer-events-none",
          "opacity-50",
          "cursor-not-allowed"
        );
        portal.setAttribute("aria-disabled", "true");
        portal.setAttribute("title", "Please log in to access portals");
      });
    }
  });
</script>
