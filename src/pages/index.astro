---
import MainLayout from "../layouts/MainLayout.astro";
import HomeCTA from "../components/ui/HomeCTA.vue";
import BaseAnimation from "../components/services/BaseAnimation.vue";
import LoginPopupHelper from "../components/ui/modals/LoginPopupHelper.vue";
import IconService from "../components/services/IconService.vue";
import FirebaseService from "../lib/firebaseService.js";

interface TeacherInfo {
  name: string;
}

interface FeaturedClass {
  id: string;
  name: string;
  teacher?: TeacherInfo;
  image: string;
  description: string;
  // other properties like createdAt are also present from FirebaseService
}

let featuredClasses: FeaturedClass[] = [];
try {
  const { classes } = await FirebaseService.getClasses({
    isPublic: true,
    includeTeacherInfo: true,
  });
  // getClasses sorts by createdAt desc, so the first 2 are the newest.
  // Asserting type here for safety, though classes from JS FirebaseService are any
  const baseClasses = classes.slice(0, 2) as FeaturedClass[];

  // Add manual image URLs and descriptions
  featuredClasses = baseClasses.map((course, index) => ({
    ...course,
    image:
      index === 0
        ? "/acatemy-home.png" // First course image
        : "/webdev-home.png", // Second course image
    description:
      index === 0
        ? "Designed for kids in grades 1-3, a gentle introduction to Artificial Intelligence, hosted by cheerful cats! Join the aCATemy now for free and earn badges and a certificate."
        : "Learn the fundamentals of web development with our comprehensive project-based curriculum covering HTML, CSS, and JavaScript basics.",
  }));
} catch (error) {
  console.error("Error fetching featured classes:", error);
  // featuredClasses will remain empty, and the section might not render or show a message
}
---

<MainLayout title="Welcome">
  <div class="bg-white pb-10 rounded">
    <!-- Hero Section -->
    <section class="py-5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="text-center lg:text-left">
            <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-6">
              Transform Your Learning Experience
            </h1>
            <p class="text-xl text-secondary-600 mb-8">
              Join our innovative platform where teachers create engaging
              quizzes and students achieve their full potential through
              personalized learning.
            </p>
            <div
              class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
            >
              <button
                onclick="window.dispatchEvent(new CustomEvent('show-register-modal'))"
                class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                Get Started
              </button>
              <a
                href="#how-it-works"
                class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                Learn More
              </a>
            </div>
          </div>
          <div class="flex justify-center">
            <BaseAnimation
              type="learning"
              client:load
              size="500"
              loop="false"
            />
          </div>
        </div>
      </div>
    </section>

    <LoginPopupHelper client:load />

    <section class="py-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- For Teachers -->
        <div
          class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
        >
          <div class="p-6">
            <h2 class="text-2xl font-bold text-secondary-900 mb-2">
              For Teachers
            </h2>
            <p class="text-secondary-600 mb-4">
              Upload lesson plans and autogenerate editable assessments. Track
              student progress all in one place.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Create and manage courses
              </li>
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Assign auto-graded differentiated tests
              </li>
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Track student performance
              </li>
            </ul>
            <a
              href="/teacher"
              class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
            >
              Teacher Portal
            </a>
          </div>
        </div>

        <!-- For Students -->
        <div
          class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
        >
          <div class="p-6">
            <h2 class="text-2xl font-bold text-secondary-900 mb-2">
              For Students
            </h2>
            <p class="text-secondary-600 mb-4">
              Access and complete your assignments or join a free, open course.
            </p>
            <ul class="space-y-2 mb-6">
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Access course materials
              </li>
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Take assisted assessments
              </li>
              <li class="flex items-center">
                <IconService name="check" size="6" color="text-green-500" />
                Earn badges and certificates
              </li>
            </ul>
            <a
              href="/student"
              class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold py-2 px-6 rounded-lg transition"
            >
              Student Portal
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-1 gap-12 max-w-2xl mx-auto">
          <div class="flex flex-col items-center">
            <img
              src="/pathways.png"
              alt="How DifferenTest Works for Teachers and Students"
              class="rounded-lg shadow-md w-full h-auto bg-white border border-gray-200"
              loading="lazy"
            />
          </div>
         
        </div>
      </div>
    </section>

    <!-- Featured Curricula Section -->
    {
      featuredClasses && featuredClasses.length > 0 && (
        <section id="featured-curricula" class="py-16">
          <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center text-secondary-900 mb-12">
              Featured Free Curricula
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
              {featuredClasses.map((course) => (
                <a
                  href={`/openclasses/${course.id}`}
                  class="block bg-white rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-200 group"
                >
                  <div class="p-6">
                    <h3 class="text-2xl font-semibold text-primary-700 mb-3 group-hover:text-primary-800">
                      {course.name}
                    </h3>
                    {/* Image callout placeholders */}
                    <div class="flex space-x-2 mb-4">
                      <div class="flex items-center justify-center text-sm text-gray-500 w-full">
                        <img
                          src={course.image}
                          alt={course.description}
                          class="rounded-lg w-full object-contain"
                        />
                      </div>
                    </div>
                    <p class="text-secondary-700 mb-4">{course.description}</p>
                    <span class="inline-block bg-primary-600 text-white font-medium py-2 px-5 rounded-lg group-hover:bg-primary-700 transition-colors">
                      Start Learning for Free Now
                    </span>
                  </div>
                </a>
              ))}
            </div>
            {featuredClasses.length === 1 && (
              <div class="mt-8 text-center text-secondary-600">
                <p>More featured curricula coming soon!</p>
              </div>
            )}
            {featuredClasses.length === 0 && (
              <div class="mt-8 text-center text-secondary-600">
                <p>
                  No featured curricula available at the moment. Check back
                  soon!
                </p>
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- Features Section -->
    <section id="features" class="py-5">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Features</h2>
        <div
          class="grid grid-cols-1 p-10 md:grid-cols-4 gap-8 bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
        >
          <!-- Feature 1 -->
          <div class="text-center">
            <div
              class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
            >
              <IconService
                name="home-lightbulb"
                size="10"
                color="text-primary-600"
              />
            </div>
            <h3 class="text-xl font-bold mb-2">Smart Quiz Generation</h3>
            <p class="text-secondary-600">
              Generate quizzes automatically from your lesson content using AI.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="text-center">
            <div
              class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
            >
              <IconService
                name="home-clipboard"
                size="10"
                color="text-primary-600"
              />
            </div>
            <h3 class="text-xl font-bold mb-2">Progress Tracking</h3>
            <p class="text-secondary-600">
              Monitor student performance and progress with detailed analytics
              and insights.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="text-center">
            <div
              class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
            >
              <IconService
                name="home-chat"
                size="10"
                color="text-primary-600"
              />
            </div>
            <h3 class="text-xl font-bold mb-2">Instant Feedback</h3>
            <p class="text-secondary-600">
              Get immediate results and detailed explanations for better
              learning outcomes.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="text-center">
            <div
              class="w-16 h-16 mx-auto bg-primary-100 rounded-full flex items-center justify-center mb-4"
            >
              <IconService name="star" size="10" color="text-primary-600" />
            </div>
            <h3 class="text-xl font-bold mb-2">Micro-credentialing</h3>
            <p class="text-secondary-600">
              Students can earn stackable credentials and certificates via
              verified achievements.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-5 bg-primary-600 text-white text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-lg text-primary-100 mb-8 max-w-2xl mx-auto">
        Join thousands of teachers and students already using DifferenTest to
        transform their educational experience.
      </p>
      <HomeCTA client:load />
    </section>

    <!-- About Section -->
    <section
      id="about"
      class="py-16 m-5 bg-white rounded-lg shadow-md overflow-hidden border border-gray-200"
    >
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">About DifferenTest</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- 1 -->
          <div class="text-center">
            <h3 class="text-xl font-bold mb-2">
              Students Supported, Teachers in Control
            </h3>
            <p class="text-secondary-600">
              Students can access their assessments and progress at any time,
              from any device and communicate with their instructors safely and
              securely. Teachers have full control over building their
              assessments and can easily edit them.
            </p>
          </div>

          <!-- 2 -->
          <div class="text-center">
            <h3 class="text-xl font-bold mb-2">Cutting-Edge Technology</h3>
            <p class="text-secondary-600">
              DifferenTest uses AI to generate editable, differentiated
              assessments with a clear pathway for students, based on a
              teacher's documented learning objectives. Micro-credentialing,
              stacking to a full badged credential.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc } from "firebase/firestore";
  import { auth, db } from "../lib/firebase";

  onAuthStateChanged(auth, async (user) => {
    if (user) {
      try {
        const userDoc = await getDoc(doc(db, "users", user.uid));

        if (userDoc.exists()) {
          const role = userDoc.data().role;

          // Get portal buttons
          const teacherPortal = document.querySelector('a[href="/teacher"]');
          const studentPortal = document.querySelector('a[href="/student"]');

          if (teacherPortal && studentPortal) {
            if (role === "student") {
              // Disable teacher portal for students
              teacherPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.setAttribute("aria-disabled", "true");
              teacherPortal.setAttribute(
                "title",
                "Only available for teachers"
              );

              // Enable student portal
              studentPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.removeAttribute("aria-disabled");
            } else if (role === "teacher") {
              // Enable teacher portal
              teacherPortal.classList.remove(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              teacherPortal.removeAttribute("aria-disabled");

              // Disable student portal for teachers
              studentPortal.classList.add(
                "pointer-events-none",
                "opacity-50",
                "cursor-not-allowed"
              );
              studentPortal.setAttribute("aria-disabled", "true");
              studentPortal.setAttribute(
                "title",
                "Only available for students"
              );
            }
          }
        }
      } catch (error) {
        console.error("Error checking user role:", error);
      }
    } else {
      // If no user is logged in, disable both portals
      const portals = document.querySelectorAll(
        'a[href="/teacher"], a[href="/student"]'
      );
      portals.forEach((portal) => {
        portal.classList.add(
          "pointer-events-none",
          "opacity-50",
          "cursor-not-allowed"
        );
        portal.setAttribute("aria-disabled", "true");
        portal.setAttribute("title", "Please log in to access portals");
      });
    }
  });
</script>
