---
import MainLayout from "../layouts/MainLayout.astro";
import RoleBasedContent from "../components/RoleBasedContent.vue";
import MessageCenter from "../components/MessageCenter.vue";
---

<MainLayout title="Messages">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Messages</h1>
      <a
        href="/teacher"
        class="text-primary-600 hover:text-primary-800 flex items-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 mr-2"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
            clip-rule="evenodd"></path>
        </svg>
        Back to Dashboard
      </a>
    </div>

    <RoleBasedContent client:only>
      <div class="bg-white rounded-lg shadow-md p-6">
        <MessageCenter client:load />
      </div>
    </RoleBasedContent>
  </div>
</MainLayout>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { auth } from "../lib/firebase";

  // This script will redirect non-authenticated users away from this page
  onAuthStateChanged(auth, (user) => {
    if (!user) {
      window.location.href = "/?auth=required";
    }
  });
</script>
