---
import MainLayout from "../layouts/MainLayout.astro";
import RoleBasedContent from "../components/RoleBasedContent.vue";
import MessageCenter from "../components/MessageCenter.vue";
---

<MainLayout title="Messages">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Messages</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <RoleBasedContent client:only :required-roles="['student', 'teacher']">
        <MessageCenter client:load />
      </RoleBasedContent>
    </div>
  </div>
</MainLayout>

<script>
  import FirebaseService from "../lib/firebaseService";

  // Check authentication using FirebaseService
  FirebaseService.requireAuth();
</script>
