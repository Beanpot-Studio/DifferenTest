---
import MainLayout from "../layouts/MainLayout.astro"; 
import HelpCenter from "../components/ui/HelpCenter.vue";
---

<MainLayout title="Help Center">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Help Center</h1>
        <a
        href="/"
        class="text-primary-600 hover:text-primary-800 flex items-center"
      >← Back to Home
      </a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <HelpCenter client:load />
    </div>
  </div>
</MainLayout>
