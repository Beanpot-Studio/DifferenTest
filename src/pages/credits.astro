---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Credits & Acknowledgements">
    <div class="max-w-4xl mx-auto px-4 py-8">
        <div class="mb-12">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">Credits</h1>
    </div>


    <section>
     
      <p class="mb-4">
        This project was built with the help and inspiration from countless
        open-source contributors and the wider web development community. Thank
        you!
      </p>
      <p class="mb-4">
        Special thanks to the authors of the Web Dev for Beginners course from Microsoft; 
        they are listed at <a href="https://aka.ms/webdev-beginners">https://aka.ms/webdev-beginners</a>. Thank you to Stella Hu for the idea of aCATemy!
      </p>
      <p class="mb-4">
        Thank you to Stella Hu for the idea of aCATemy!
      </p>
      <p class="mb-4">
        Thank you to the Front-End Foxes organization for your excellent curriculum.
      </p>
    </section>
  </div>
</MainLayout>
