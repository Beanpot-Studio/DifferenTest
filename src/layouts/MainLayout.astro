---
import Header from "../components/ui/Header.vue";
import Footer from "../components/ui/Footer.vue";
import NotificationContainer from "../components/services/NotificationContainer.vue";
import "../styles/global.css";

// Import a helper to get initial theme *without* Vue reactivity for SSR
const getInitialThemeSSR = (): string => {
  return "default";
};

const initialTheme = getInitialThemeSSR();

interface Props {
  title: string;
  metaTags?: Array<{ property?: string; name?: string; content: string }>;
}

const { title, metaTags = [] } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={initialTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="DifferenTest - Personalized Learning Platform"
    />
    <meta
      name="keywords"
      content="personalized learning, education, platform, students, teachers, adaptive learning, online courses, differentiated assessments, free online courses, premium online learning, upskilling"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | DifferenTest</title>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={`${title} | DifferenTest`} />
    <meta
      property="og:description"
      content="DifferenTest - Personalized Learning Platform for students and teachers."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/linkedin.jpg" />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DifferenTest`} />
    <meta
      name="twitter:description"
      content="DifferenTest - Personalized Learning Platform for students and teachers."
    />
    <meta name="twitter:image" content="/twitter.jpg" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L2S7BFGPSG"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-L2S7BFGPSG");
    </script>

    <!-- Dynamic Meta Tags -->
    {metaTags.map((tag) => <meta {...tag} />)}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"
      integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"></script>
  </head>
  <body
    class="flex flex-col min-h-screen bg-gradient-to-t from-primary-300 to-white text-secondary-900 font-sans"
  >
    <Header client:load />

    <main class="flex-grow pt-12 relative z-10">
      <NotificationContainer client:load />
      <div class="container p-10">
        <slot />
      </div>
    </main>

    <Footer />

    <div class="absolute w-full top-5 max-h-12 z-0">
      <img src="/wave.svg" alt="Wave" class="w-full h-full object-cover" />
    </div>

    <script>
      import { useAuth } from "../stores/auth";
      const { cleanup } = useAuth();

      window.addEventListener("unload", () => {
        cleanup();
      });
    </script>
  </body>
</html>
