---
import Header from "../components/Header.vue";
import Footer from "../components/Footer.vue";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="DifferenTest - Personalized Learning Platform"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | DifferenTest</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex flex-col min-h-screen bg-secondary-50 text-secondary-900 font-sans"
  >
    <Header client:load />

    <main class="flex-grow py-8">
      <div class="container mx-auto px-4">
        <slot />
      </div>
    </main>

    <Footer />

    <div class="absolute w-full top-0 max-h-12">
      <img src="/wave.svg" alt="Wave" class="w-full h-full object-cover" />
    </div>

    <script>
      import { useAuth } from "../stores/auth";
      const { initialize, cleanup } = useAuth();

      initialize();
      window.addEventListener("unload", () => {
        cleanup();
      });
    </script>
  </body>
</html>
