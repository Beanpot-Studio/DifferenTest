---
import Header from "../components/Header.vue";
import Footer from "../components/Footer.vue";
import NotificationContainer from "../components/NotificationContainer.vue";
// import SkinSelector from "../components/SkinSelector.vue";
import "../styles/global.css";
import { useAuth } from "../stores/auth";

// Import a helper to get initial theme *without* Vue reactivity for SSR
const getInitialThemeSSR = (): string => {
  // Can't access localStorage on server, so default or use a cookie/header if set
  // For simplicity, defaulting here. A more robust solution might read a cookie.
  return "default";
};

const initialTheme = getInitialThemeSSR();
const { user, role, isLoggedIn } = useAuth(); // Get user role if needed for selector

interface Props {
  title: string;
  metaTags?: Array<{ property?: string; name?: string; content: string }>;
}

const { title, metaTags = [] } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={initialTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="DifferenTest - Personalized Learning Platform"
    />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.PUBLIC_BASE_URL || ""}/favicon.svg`}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | DifferenTest</title>

    <!-- Dynamic Meta Tags -->
    {metaTags.map((tag) => <meta {...tag} />)}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex flex-col min-h-screen bg-gradient-to-t from-primary-300 to-white text-secondary-900 font-sans"
  >
    <Header client:load />

    <main class="flex-grow pt-12 relative z-10">
      <NotificationContainer client:load />
      <div class="container p-10">
        <slot />
      </div>
    </main>

    <Footer />

    <div class="absolute w-full top-5 max-h-12 z-0">
      <img
        src={`${import.meta.env.PUBLIC_BASE_URL || ""}/wave.svg`}
        src={`${Astro.url.origin}/${import.meta.env.PUBLIC_BASE_URL || ""}/wave.svg`}
        alt="Wave"
        class="w-full h-full object-cover"
      />
    </div>

    <script>
      // Remove the global useSkin() call from here
      // import { useSkin } from "../composables/useSkin";
      // useSkin();

      import { useAuth } from "../stores/auth";
      const { initialize, cleanup } = useAuth();

      initialize();
      window.addEventListener("unload", () => {
        cleanup();
      });
    </script>
  </body>
</html>
