rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is enrolled in a class
    function isEnrolledInClass(classId) {
      return exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + classId));
    }

    // Helper function to check if a class is public
    function isPublicClass(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.isPublic == true;
    }

    // Public access rules
    match /classes/{classId} {
      // Allow all authenticated users to read classes
      allow read: if request.auth != null;
      // Only allow teacher to write
      allow write: if request.auth != null && (
        resource.data.teacherId == request.auth.uid || 
        request.resource.data.teacherId == request.auth.uid
      );
    }
    
    // User data rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Quiz rules
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource.data.teacherId == request.auth.uid || 
        request.resource.data.teacherId == request.auth.uid
      );
    }
    
    // Quiz attempts rules
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null && (
        // Student can read their own attempts
        resource.data.studentId == request.auth.uid ||
        // Teacher can read attempts for their quizzes
        get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.teacherId == request.auth.uid ||
        // Student can read attempts for their enrolled classes
        isEnrolledInClass(resource.data.classId)
      );
      allow create: if request.auth != null;
    }
    
    // Activities rules
    match /activities/{activityId} {
      allow read: if request.auth != null && (
        // User can read their own activities
        resource.data.userId == request.auth.uid ||
        // User can read activities from their enrolled classes
        isEnrolledInClass(resource.data.classId) ||
        // Teacher can read activities from their classes
        resource.data.teacherId == request.auth.uid
      );
      allow create: if request.auth != null;
    }
    
    // Enrollments rules
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        // Student can read their own enrollments
        resource.data.studentId == request.auth.uid ||
        // Teacher can read enrollments for their classes
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid ||
        // Student can read enrollments for classes they're enrolled in
        isEnrolledInClass(resource.data.classId)
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid
      );
    }
    
    // Badges rules
    match /badges/{badgeId} {
      allow read, write: if request.auth != null;
    }
  }
}